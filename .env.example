# Local project paths
DATA_DIR=data
BTS_RAW_DIR=data/raw/bts

# Keep notebook and script runs reproducible.
PROJECT_ENV=local

# Local PostgreSQL container
POSTGRES_DB=airline_ops
POSTGRES_USER=airline_user
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DBT_TARGET_PATH=dbt/target

# Local Airflow services (development only)
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=change_me_for_airflow_metadata
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change_me_for_airflow_admin
AIRFLOW_JWT_SECRET=replace_with_a_long_random_value
AIRFLOW_FERNET_KEY=replace_with_a_valid_fernet_key
